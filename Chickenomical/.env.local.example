# WorkOS AuthKit Configuration (Frontend)
VITE_WORKOS_CLIENT_ID=YOUR-WORKOS-CLIENT-ID
VITE_WORKOS_REDIRECT_URI=http://localhost:5173/callback

# Convex Configuration
VITE_CONVEX_URL=your-convex-url

# Convex server secrets: configure with `npx convex env set`; never expose to Vite.
# BRIGHTDATA_API_TOKEN=...
# BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
# APIFY_TOKEN=...
# APIFY_DOORDASH_ACTOR_ID=dz_omar/doordash-scraper
# APIFY_UBEREATS_ACTOR_ID=datacach/ubereats-menu-scraper
# INGEST_SHARED_SECRET=use-a-long-random-secret

# Server-side Convex environment variables: set with `npx convex env set`,
# never with a VITE_ prefix and never committed to this file.
# BRIGHTDATA_API_TOKEN=...
# BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
# APIFY_TOKEN=...
# APIFY_DOORDASH_ACTOR_ID=dz_omar/doordash-scraper
# APIFY_UBEREATS_ACTOR_ID=datacach/ubereats-menu-scraper
