{
  "expo": {
    "name": "Chickenomical",
    "slug": "chickenomical",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chickenomical",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.duckdoquack.chickenomical"
    },
    "android": {
      "package": "com.duckdoquack.chickenomical",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFF7EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Chickenomical",
      "shortName": "Chickenomical",
      "themeColor": "#2E252C",
      "barStyle": "black-translucent"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Chickenomical uses your location to find the nearest saved restaurants."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101010",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "convexUrl": "https://focused-chameleon-321.convex.cloud",
      "scrapeProxyUrl": "https://chickenomical-web.quacksire.workers.dev",
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "711497a5-1421-4d2a-8e0f-1ff99ec364a6"
      }
    },
    "owner": "duckdoquack"
  }
}
